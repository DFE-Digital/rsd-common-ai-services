{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} {Level:u3} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "APPLICATIONINSIGHTS_CONNECTION_STRING": "",
  "AiAgents": {
    "ApplicationName": "rsd-common-ai-services",
    "Foundry": {
      "Endpoint": "",
      "DefaultModel": ""
    },
    "Authentication": {
      "TenantId": "",
      "ClientId": ""
    },
    "PromptFiles": {
      "SystemPrompts": {
        "Establishment": "Prompts/Establishment.md",
        "Trust": "Prompts/Trust.md"
      }
    },
    "RequireTokenUsageTelemetry": true,
    "RunTimeout": "00:05:00",
    "Guardrails": {
      "SubscriptionId": "",
      "ResourceGroup": "",
      "Name": "rsd-common-agents-guardrail",
      "Targets": "Agents",
      "BlockFrom": "Medium",
      "PromptShields": true,
      "IndirectAttacks": true,
      "ProtectedMaterial": true,
      "ScanPrompts": true,
      "ScanEvidence": true,
      "CheckBlocklists": true,
      "RequireAtStartup": false,
      "Blocklists": {
        "personal-identifiers": {
          "Patterns": [
            "[A-Z][0-9]{11}[0-9A-Z]",
            "[A-CEGHJ-PR-TW-Z]{2}[0-9]{6}[A-D]"
          ]
        }
      }
    },
    "Evaluation": {
      "JudgeModel": "",
      "SampleRate": 0,
      "ReleaseGate": {
        "MinimumScore": 3.5,
        "MaxParallelTestRuns": 8,
        "Repeats": 1,
        "PublishToFoundry": false,
        "Tolerance": 0.2,
        "MaxGroupGap": 0.5,
        "BaselinesDirectory": "Baselines",
        "ReportsDirectory": "evaluation-reports"
      }
    },
    "Pricing": {
      "Currency": "GBP",
      "Models": {
        "gpt-5.1": {
          "CostPer1kTokensInput": 0.00093,
          "CostPer1kTokensCachedInput": 0.0001,
          "CostPer1kTokensOutput": 0.00741
        }
      }
    }
  }
}
