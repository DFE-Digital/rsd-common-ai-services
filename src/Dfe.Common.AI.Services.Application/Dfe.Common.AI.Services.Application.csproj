<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.10.0" />
    <PackageReference Include="GovUK.Dfe.AI.Agents" Version="0.0.1-prerelease.2932" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dfe.Common.AI.Services.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- System prompts are read from the output directory; they flow to any project that references this one. -->
    <Content Include="Prompts\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The guardrail and evaluation checks every agent must pass before it's provisioned, with their test cases. -->
    <ProjectReference Include="..\Dfe.Common.AI.Services.ReleaseGate\Dfe.Common.AI.Services.ReleaseGate.csproj" />
  </ItemGroup>

</Project>
